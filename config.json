{
  "output_file": "Mono.txt",
  "output_dir": "out",
  "ignored_dirs": [
    "node_modules",
    "dist",
    "storage",
    ".idea",
    ".git",
    "__pycache__",
    ".venv",
    "bin",
    "obj",
    "Debug",
    ".next",
    "venv",
    ".pytest_cache",
    "out"
  ],
  "ignored_files": [
    "package-lock.json"
  ],
  "ignored_extensions": [
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".bmp",
    ".webp",
    ".ico",
    ".tiff",
    ".mp4",
    ".mp3",
    ".wav",
    ".ogg",
    ".pdf",
    ".zip",
    ".tar",
    ".gz",
    ".rar",
    ".svg",
    ".log",
    ".sln"
  ],
  "skip_css_if_no_ext": true,
  "use_gitignore": true,
  "performance": {
    "max_workers": 0,
    "large_file_threshold_mb": 5,
    "output_buffer_kb": 256,
    "progress_update_interval_ms": 100,
    "batch_libreoffice": true,
    "parallel_pdf_fallback": true,
    "min_tasks_for_parallel": 8,
    "pdf_batch_threshold": 200
  }
}